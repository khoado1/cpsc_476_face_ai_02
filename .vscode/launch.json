{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FaceDetectSimple.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/FaceDetectSimple.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
